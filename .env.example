# ==================== 大模型 API 配置（任意 OpenAI 兼容接口）====================
# 把 API Key 填在等号后面即可。改 LLM_BASE_URL / LLM_MODEL 两行就能切换厂商：

# —— 小米 MiMo（当前使用）——
# 获取 Key：https://mimo.mi.com （控制台 → API Keys）
# ⚠️ 两套密钥通道必须配套，不能混用：
#    sk- 开头 = 按量付费通道 → https://api.xiaomimimo.com/v1
#    tp-/ttp- 开头 = Token Plan 通道 → https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.6-flash

# —— 其他厂商示例（按需替换上面三行）——
# 智谱 GLM：  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  |  LLM_MODEL=glm-4.7-flash（免费档）
# DeepSeek：  LLM_BASE_URL=https://api.deepseek.com/v1  |  LLM_MODEL=deepseek-chat
# 通义千问：  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  |  LLM_MODEL=qwen-plus

# —— 生成参数（可选）——
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# 深度思考开关：off=关闭（回答更快更便宜）/ on=开启 / 留空=不传该参数（智谱、MiMo 支持该参数）
LLM_THINKING=off
# 上游并发上限（MiMo 限速 100 RPM，个人站 3 并发足够；超出会排队等待而非报错）
LLM_MAX_CONCURRENCY=3

# ==================== 服务配置（可选）====================
HOST=0.0.0.0
PORT=8000

# ==================== 管理后台（/admin）====================
# 登录密码，请改成只有你自己知道的密码（部署到公网前务必修改）
ADMIN_PASSWORD=change-me
